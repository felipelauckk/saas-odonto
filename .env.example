# Copie este arquivo para .env.local e preencha. Nunca envie o .env.local para o Git.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (Etapa 10)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox

# WhatsApp (Etapa 9). Sem WHATSAPP_PROVIDER, o envio é simulado (só registra no log).
# meta = WhatsApp Cloud API oficial: os modelos abaixo precisam estar aprovados na Meta.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_REMINDER=lembrete_consulta
WHATSAPP_TEMPLATE_CONFIRMATION=consulta_confirmada
WHATSAPP_TEMPLATE_BIRTHDAY=aniversario
WHATSAPP_TEMPLATE_PAYMENT=lembrete_cobranca
WHATSAPP_TEMPLATE_CODE=codigo_agendamento
WHATSAPP_TEMPLATE_RETURN=retorno

# Rotina diária de lembretes (Vercel Cron envia este segredo)
CRON_SECRET=

# Criptografia das chaves de API das clínicas (Asaas da clínica). 32 bytes em base64:
#   openssl rand -base64 32
# Trocar esta chave invalida as conexões já salvas (a clínica conecta de novo).
CLINIC_SECRETS_KEY=

# Banco de testes (opcional). Crie um .env.test.local com as mesmas variáveis do
# Supabase apontando para um projeto só de testes: o Vitest e o Playwright dão
# prioridade a ele, e o banco de produção não recebe os dados dos testes.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
